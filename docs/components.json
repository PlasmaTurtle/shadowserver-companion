  "rules": [
    {
      "name": "Intake has no application or provider dependency",
      "source": [
        "workbench.intake"
      ],
      "allow_internal": [
        "workbench.intake"
      ],
      "deny_external": [
        "requests",
        "httpx",
        "socket",
        "sqlite3",
        "fastapi",
        "urllib.request"
      ]
    },
    {
      "name": "Primitives stay independent",
      "source": [
        "workbench.primitives"
      ],
      "allow_internal": [],
      "deny_external": [
        "requests",
        "httpx",
        "socket",
        "sqlite3",
        "fastapi",
        "urllib.request"
      ]
    },
    {
      "name": "Pure CVE adapters do not acquire or persist",
      "source": [
        "workbench.intelligence.adapters",
        "workbench.intelligence.identifiers",
        "workbench.cve_intelligence",
        "workbench.intelligence_models",
        "workbench.cve_state"
      ],
      "allow_internal": [
        "workbench.intelligence.adapters",
        "workbench.intelligence.identifiers",
        "workbench.cve_intelligence",
        "workbench.intelligence_models",
        "workbench.cve_state"
      ],
      "deny_external": [
        "requests",
        "httpx",
        "socket",
        "sqlite3",
        "fastapi",
        "urllib.request"
      ]
    },
    {
      "name": "Acquisition cannot reach case workflow",
      "source": [
        "workbench.intelligence.acquisition"
      ],
      "allow_internal": [
        "workbench.intelligence.adapters",
        "workbench.primitives",
        "workbench.cve_intelligence",
        "attribution",
        "workbench.repositories.sources",
        "workbench.cve_catalog",
        "workbench.aegis"
      ],
      "deny": [
        "workbench.store",
        "workbench.api",
        "workbench.cases",
        "workbench.reporting",
        "workbench.report_snapshot",
        "workbench.intelligence.service"
      ],
      "allow_exact": [
        "workbench"
      ]
    },
    {
      "name": "Standalone attribution cannot import workbench",
      "source": [
        "attribution"
      ],
      "deny": [
        "workbench",
        "excel_intake"
      ]
    },
    {
      "name": "Application does not import legacy CLI",
      "source": [
        "workbench"
      ],
      "deny": [
        "excel_intake"
      ]
    },
    {
      "name": "Observatory does not import intake or source jobs",
      "source": [
        "workbench.eclipse",
        "workbench.intelligence_index"
      ],
      "deny": [
        "workbench.intake_service",
        "workbench.cve_sources",
        "workbench.intelligence.acquisition",
        "workbench.intelligence.service",
        "workbench.source_jobs"
      ],
      "deny_external": [
        "requests",
        "httpx",
        "socket",
        "sqlite3",
        "fastapi",
        "urllib.request"
      ]
    },
    {
      "name": "Repositories never coordinate workflow",
      "source": [
        "workbench.repositories"
      ],
