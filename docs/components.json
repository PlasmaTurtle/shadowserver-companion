      "entry": "workbench.api:create_app",
      "contract": "Composes Store, jobs and workflow services; validates HTTP requests and launcher sessions. Existing routes and response shapes stay stable.",
      "tests": [
        "tests/test_api_structure_071.py",
        "tests/test_local_session_072.py",
        "tests/test_api_070.py"
      ],
      "next_work": ""
