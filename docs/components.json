{
  "schema": 1,
  "description": "Owned source components; actual Python/ES imports are generated. Runtime dynamic dispatch and SQL relationships require the explicit contracts below.",
  "components": [
    {
      "id": "browser",
      "name": "Browser workspace",
      "kind": "UI components",
      "paths": [
        "static/*.js",
        "static/modules/*.js"
      ],
      "entry": "static/app.js:createApplication",
      "contract": "Owns per-instance browser state and feature handlers. events.js owns delegated listeners; navigation owns routes/bootstrap. Uses authenticated HTTP and explicit teardown; action registry and ECLIPSE global remain integration boundaries.",
      "tests": [
        "npm test",
        "npm run lint",
        "tests/test_contacts_browser_090.cjs",
        "tests/test_admission_ui_0110.cjs",
        "tests/test_entity_lifecycle_ui_0110.cjs",
        "tests/test_workspace_health_ui_0110.cjs"
      ],
      "next_work": "Define ECLIPSE and renderer asset interfaces before independent packaging; preserve dirty and freeze contracts."
    },
    {
      "id": "api",
      "name": "Local API & startup",
      "kind": "Application boundary",
      "paths": [
        "run.py",
        "workbench/api.py",
