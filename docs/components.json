{
  "schema": 1,
  "description": "Application modules own their runtime code, tools, assets and tests. Explicit root paths own project-wide startup and release infrastructure. Fine-grained import rules define shared capability and workflow boundaries.",
  "components": [
    {
      "id": "workspace",
      "name": "Workspace",
      "kind": "Application module",
      "paths": [
        "modules/workspace/**"
      ],
      "entry": "modules/workspace/docs/README.md",
      "contract": "Application composition, shared persistence/security, workspace recovery/health and daily work queues.",
      "tests": [
        "modules/workspace/tests"
      ],
      "next_work": "Use the module guide for ownership; split mixed-responsibility files in targeted follow-up changes."
    },
    {
      "id": "investigations",
      "name": "Investigations",
      "kind": "Application module",
      "paths": [
        "modules/investigations/**"
      ],
      "entry": "modules/investigations/docs/README.md",
      "contract": "Case workflow, report composition, certification, preserved evidence and completed notification history from recorded delivery.",
      "tests": [
        "modules/investigations/tests"
      ],
      "next_work": "Use the module guide for ownership; split mixed-responsibility files in targeted follow-up changes."
    },
    {
      "id": "observatory",
      "name": "Observatory",
      "kind": "Application module",
      "paths": [
        "modules/observatory/**"
      ],
      "entry": "modules/observatory/docs/README.md",
      "contract": "Read-only retained-observation projections, geography and visual field navigation.",
      "tests": [
        "modules/observatory/tests"
      ],
      "next_work": "Use the module guide for ownership; split mixed-responsibility files in targeted follow-up changes."
    },
    {
      "id": "entities",
      "name": "Entities",
      "kind": "Application module",
      "paths": [
        "modules/entities/**"
      ],
      "entry": "modules/entities/docs/README.md",
      "contract": "Canonical business identities, merge history, reviewed profile fields and contact discovery.",
      "tests": [
        "modules/entities/tests"
      ],
      "next_work": "Use the module guide for ownership; split mixed-responsibility files in targeted follow-up changes."
    },
    {
      "id": "leads",
      "name": "Leads",
      "kind": "Application module",
      "paths": [
        "modules/leads/**"
      ],
      "entry": "modules/leads/docs/README.md",
      "contract": "Qualified lead review, finding-based queue filters, saved capture previews and lead export contracts.",
      "tests": [
        "modules/leads/tests"
      ],
      "next_work": "Use the module guide for ownership; split mixed-responsibility files in targeted follow-up changes."
    },
    {
      "id": "attribution",
      "name": "Attribution",
      "kind": "Application module",
      "paths": [
        "modules/attribution/**"
      ],
      "entry": "modules/attribution/docs/README.md",
      "contract": "Registration and DNS evidence, approved attribution, proof reuse, NC business registry schema and the independent attribution engine.",
      "tests": [
        "modules/attribution/tests"
      ],
      "next_work": "Use the module guide for ownership; split mixed-responsibility files in targeted follow-up changes."
    },
    {
      "id": "accretion",
      "name": "Accretion (Data)",
      "kind": "Application module",
      "paths": [
        "modules/accretion/**"
      ],
      "entry": "modules/accretion/docs/README.md",
      "contract": "Report acquisition, duplicate import detection, grouped qualification, priority evaluation and final case/entity deconfliction in Associate.",
      "tests": [
        "modules/accretion/tests"
      ],
      "next_work": "Use the module guide for ownership; split mixed-responsibility files in targeted follow-up changes."
    },
    {
      "id": "library",
      "name": "Library",
      "kind": "Application module",
      "paths": [
        "modules/library/**"
      ],
      "entry": "modules/library/docs/README.md",
      "contract": "CVE/reference catalogs, intelligence acquisition and reusable editorial content.",
      "tests": [
        "modules/library/tests"
      ],
      "next_work": "Use the module guide for ownership; split mixed-responsibility files in targeted follow-up changes."
    },
    {
      "id": "settings",
      "name": "Settings",
      "kind": "Application module",
      "paths": [
        "modules/settings/**"
      ],
      "entry": "modules/settings/docs/README.md",
      "contract": "Setup, sender identity, configuration and software update settings.",
      "tests": [
        "modules/settings/tests"
      ],
      "next_work": "Use the module guide for ownership; split mixed-responsibility files in targeted follow-up changes."
    },
    {
      "id": "activity",
      "name": "Activity",
      "kind": "Application module",
      "paths": [
        "modules/activity/**"
      ],
      "entry": "modules/activity/docs/README.md",
      "contract": "Recorded work history and activity presentation.",
      "tests": [
        "modules/activity/tests"
      ],
      "next_work": "Use the module guide for ownership; split mixed-responsibility files in targeted follow-up changes."
    },
    {
      "id": "ui",
      "name": "UI",
      "kind": "Application module",
      "paths": [
        "modules/ui/**"
      ],
      "entry": "modules/ui/docs/README.md",
      "contract": "Shared shell, navigation, themes and reusable rendering/font helpers.",
      "tests": [
        "modules/ui/tests"
      ],
      "next_work": "Use the module guide for ownership; split mixed-responsibility files in targeted follow-up changes."
    },
    {
      "id": "tools",
      "name": "Tools",
      "kind": "Application module",
      "paths": [
        "modules/tools/**"
      ],
      "entry": "modules/tools/docs/README.md",
      "contract": "Reusable runtime tools, including native website capture, independent of case workflow and evidence persistence.",
      "tests": [
        "modules/tools/tests"
      ],
      "next_work": "Keep tool interfaces reusable; consuming modules own workflow, UI and persistence."
    }
  ],
