        "workbench/report_profiles.py",
        "workbench/provider_policy.py"
      ],
      "entry": "workbench.intake:read_entries / EntryValidator",
      "contract": "Streams complete source rows and applies configured policy. No registry requests, database initialization or background worker. Reader policy and notification eligibility remain separate.",
      "tests": [
        "tests/test_excel_intake.py",
        "tests/test_intake_profiles_070.py",
        "tests/test_empty_rows_050.py"
      ],
      "next_work": "Separate release only if another application needs these contracts; preserve original fields and row numbers."
    },
