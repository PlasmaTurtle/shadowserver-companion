    {
      "id": "contact-discovery",
      "name": "Published contact discovery",
      "kind": "Reusable internal package",
      "paths": [
        "workbench/contact_discovery/*.py"
      ],
      "entry": "ContactDiscovery.discover / DiscoveryLimits / FetchResponse",
      "contract": "Bounded static discovery from the associated entity domain and its apex/www counterpart. Supported media, strict encoding and HTTP framing are checked before parsing; original bodies never leave the engine. External contact destinations retain first-party provenance. No database writes, JavaScript execution or outbound messages.",
      "tests": [
        "tests/test_contact_discovery_090.py"
      ],
      "next_work": "Keep parsing and transport fixture-testable; contact review and adoption belong to application services."
